int countResponseTimeRegressions(vector<int> responseTimes) {
    int count=0;
    int n=responseTimes.size();
    double sum=0;
    for(int i=0;i<n;i++){
        if(i>0){
            double avg=sum/i;
            if(responseTimes[i]>avg){
                count++;
            }
        }
        sum+=responseTimes[i];
    }
    return count;
}
